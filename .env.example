# Telegram: @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Dropbox (вариант A — refresh token, рекомендуется для бота 24/7)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Dropbox (вариант B — короткий токен, ~4 часа, только для теста)
# DROPBOX_TOKEN=

# Путь к vault в Dropbox
DROPBOX_VAULT_PATH=/Obsidian/MyVault

# Язык для Whisper
WHISPER_LANGUAGE=ru

# GMT+7
TIMEZONE=Asia/Bangkok
