# Database / cache
DATABASE_URL=postgresql+asyncpg://vault:vault@localhost:5432/vault
REDIS_URL=redis://localhost:6379/0

# Encrypt OAuth refresh tokens at rest (any secret string, or Fernet key)
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Public URL of the API (Telegram buttons + OAuth redirects derive from this).
# Must be reachable from your phone/browser. For local: use ngrok/cloudflared HTTPS URL.
PUBLIC_BASE_URL=http://localhost:8000

# Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI (or OpenAI-compatible local server)
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=ru

# Dropbox app (https://www.dropbox.com/developers/apps)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Optional override; default = {PUBLIC_BASE_URL}/oauth/dropbox/callback
# DROPBOX_REDIRECT_URI=
DROPBOX_VAULT_PATH=/Obsidian/MyVault

# Google Cloud OAuth client (Calendar + Tasks scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; default = {PUBLIC_BASE_URL}/oauth/google/callback
# GOOGLE_REDIRECT_URI=

TIMEZONE=Asia/Bangkok

# Pipeline cache TTLs
NOTE_BODY_TTL_SECONDS=259200
AUDIO_CACHE_TTL_SECONDS=3600
NOTE_BODY_EXPIRE_AFTER_UPLOAD_SECONDS=3600
